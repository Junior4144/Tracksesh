# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# Dependencies
/node_modules
npm-debug.log
yarn-error.log

# Vite
/dist/

# TypeScript
*.tsbuildinfo

# Production
/build

# The SPA build output — Vite writes it here so `dotnet publish` picks it up.
# Generated, so it is not committed; `npm run build` recreates it.
/server/Tracksesh.Api/wwwroot/*
!/server/Tracksesh.Api/wwwroot/.gitkeep

# Env — never commit real keys; .env.example is the template
.env
.env*.local

# Testing
/coverage

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json
.history/*

# .NET
/server/**/bin/
/server/**/obj/

# Vercel / Terraform (later steps)
.vercel
*.tfstate
*.tfstate.*
.terraform/

# System files
.DS_Store
Thumbs.db

# Playwright
/test-results/
/playwright-report/
/playwright/.auth/
