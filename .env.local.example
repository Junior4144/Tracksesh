# Template only — no real values here. Copy to .env.local and fill in.
#
# Hosted Supabase: Project Settings -> API Keys.
#   NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
#
# Local Supabase (`supabase start`) prints both on boot.
#
# Use the *publishable* key (sb_publishable_...), not a secret key.
# Anything NEXT_PUBLIC_* is inlined into the browser bundle.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
