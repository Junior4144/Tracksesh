# The .NET 10 SDK dropped VSTest as the `dotnet test` runner, and refuses to
# fall back to it. This opts the repo into Microsoft.Testing.Platform, which is
# the runner xunit.v3 ships with.
#
# It lives at the repo root rather than beside the test project so `dotnet test`
# finds it whether it is run from here or from server/ — discovery walks up.
[dotnet.test.runner]
name = "Microsoft.Testing.Platform"
