# Template only — no real values here. Copy to .env and fill in.
#
# These are the *browser's* half of the app: Supabase Auth, and nothing else.
# The ledger is reached through the .NET API, which is configured separately in
# server/Tracksesh.Api/appsettings*.json.
#
# Hosted Supabase: Project Settings -> API Keys.
#   VITE_SUPABASE_URL=https://<project-ref>.supabase.co
#   VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
#
# Local Supabase (`supabase start`) prints both on boot.
#
# Use the *publishable* key (sb_publishable_...), not a secret key.
# Anything VITE_* is inlined into the browser bundle at build time.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Where the API lives. Defaults to /api, which `vite dev` proxies to the API
# process (see vite.config.ts) and which is same-origin in production, because
# the same process serves both. Only set this if you host them apart — and then
# the API needs Cors:AllowedOrigins set to match.
# VITE_API_BASE_URL=/api

# Server-only admin and traffic settings. `npm run api` loads .env; deployment
# must inject these environment variables into the API process. Never add VITE_.
# Empty ADMIN_EMAILS disables the email bootstrap; app_metadata.role=admin remains valid.
ADMIN_EMAILS=gbjunior014@gmail.com
TRAFFIC_ENABLED=false
# Assign a UUID once (PowerShell: [guid]::NewGuid()) and retain it across deploys.
# Each monitored site gets its own UUID, while PostHog credentials remain shared.
TRAFFIC_SITE_ID=
TRAFFIC_DOMAIN=tracksesh.com
TRAFFIC_TARGET_IP=
# Optional operator-managed multi-site registry; see docs/TRAFFIC.md.
# TRAFFIC_SITES_JSON=[{"site_id":"<uuid>","name":"Tracksesh","domain":"tracksesh.com","target_ip":null,"cloudflare_zone_id":"<zone>","owner_user_ids":["<Supabase user UUID>"],"owner_emails":[]}]
TRAFFIC_HASH_SECRET=
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PROJECT_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_QUERY_KEY=
PROXYCHECK_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
TRAFFIC_INGRESS_LOCKED=false
TRAFFIC_TRUSTED_PROXY_HOPS=0
TRAFFIC_MONTHLY_EVENT_CAP=50000
TRAFFIC_DAILY_LOOKUP_CAP=900
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
